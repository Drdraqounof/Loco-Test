// This is your Prisma schema file.
// Learn more about it in the docs: https://pris.ly/d/prisma-schema

// In plain terms: this file describes the app's database tables and relationships.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Example model - update or remove as needed for your app
model User {
  id                     Int                       @id @default(autoincrement())
  email                  String                    @unique
  name                   String?
  createdAt              DateTime                  @default(now())
  updatedAt              DateTime                  @updatedAt
  googleCalendarConnections GoogleCalendarConnection[]
  youTubeConnections     YouTubeConnection[]

  @@index([email])
}

model GoogleCalendarConnection {
  id                  Int      @id @default(autoincrement())
  userId              Int
  provider            String   @default("google")
  email               String?
  accessToken         String   @db.Text
  refreshToken        String?  @db.Text
  expiryDate          BigInt?
  scope               String?  @db.Text
  calendarId          String   @default("primary")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
  @@index([provider])
}

model YouTubeConnection {
  id           Int      @id @default(autoincrement())
  userId       Int
  provider     String   @default("youtube")
  email        String?
  channelId    String?
  channelTitle String?
  accessToken  String   @db.Text
  refreshToken String?  @db.Text
  expiryDate   BigInt?
  scope        String?  @db.Text
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
  @@index([provider])
}

model PendingCalendarDraft {
  id                String   @id @default(cuid())
  source            String   @default("loco")
  title             String
  description       String?  @db.Text
  location          String?
  startIso          DateTime
  endIso            DateTime
  timeZone          String
  needsConfirmation Boolean  @default(true)
  rawRequest        String   @db.Text
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([createdAt])
}

model ConversationSession {
  id             String                @id @default(cuid())
  source         String                @default("loco")
  title          String
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  messages       ConversationMessage[]
  calendarEvents CalendarEventMemory[]

  @@index([source, updatedAt])
}

model ConversationMessage {
  id        String              @id @default(cuid())
  sessionId String
  role      String
  content   String              @db.Text
  position  Int
  createdAt DateTime            @default(now())
  session   ConversationSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, position])
  @@index([sessionId, createdAt])
}

model CalendarEventMemory {
  id           String               @id @default(cuid())
  source       String               @default("loco")
  googleEventId String?             @unique
  sessionId    String?
  title        String
  description  String?              @db.Text
  location     String?
  startIso     DateTime
  endIso       DateTime
  timeZone     String
  htmlLink     String?              @db.Text
  rawRequest   String?              @db.Text
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  session      ConversationSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  @@index([source, startIso])
}

model AssistantMemory {
  id                String   @id @default(cuid())
  source            String   @default("loco")
  kind              String   @default("fact")
  content           String   @db.Text
  normalizedContent String   @unique @db.Text
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([source, updatedAt])
}

model WorkforceMember {
  id          Int                  @id @default(autoincrement())
  name        String
  email       String?              @unique
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  assessments WorkforceAssessment[]

  @@index([name])
}

model WorkforceArea {
  id           Int                  @id @default(autoincrement())
  code         String               @unique
  title        String
  description  String?              @db.Text
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  competencies WorkforceCompetency[]

  @@index([code, title])
}

model WorkforceCompetency {
  id           Int                    @id @default(autoincrement())
  code         String                 @unique
  title        String
  itemType     String                 @default("skill")
  question     String?                @db.Text
  description  String?                @db.Text
  sortOrder    Int                    @default(0)
  areaId       Int?
  parentId     Int?
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt
  area         WorkforceArea?         @relation(fields: [areaId], references: [id], onDelete: SetNull)
  parent       WorkforceCompetency?   @relation("WorkforceCompetencyTree", fields: [parentId], references: [id], onDelete: SetNull)
  children     WorkforceCompetency[]  @relation("WorkforceCompetencyTree")
  rubricLevels WorkforceRubricLevel[]
  assessments  WorkforceAssessment[]

  @@index([code, title])
  @@index([areaId, itemType, sortOrder])
  @@index([parentId, sortOrder])
}

model WorkforceRubricLevel {
  id           Int                @id @default(autoincrement())
  competencyId Int
  score        Int
  sortOrder    Int
  summary      String             @db.Text
  createdAt    DateTime           @default(now())
  competency   WorkforceCompetency @relation(fields: [competencyId], references: [id], onDelete: Cascade)

  @@unique([competencyId, score])
  @@unique([competencyId, sortOrder])
  @@index([competencyId, sortOrder])
}

model WorkforceAssessment {
  id             Int                 @id @default(autoincrement())
  memberId       Int
  competencyId   Int
  assessmentDate DateTime
  selfScore      Int?
  reflection     String?             @db.Text
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  member         WorkforceMember     @relation(fields: [memberId], references: [id], onDelete: Cascade)
  competency     WorkforceCompetency @relation(fields: [competencyId], references: [id], onDelete: Cascade)
  evidenceLinks  WorkforceEvidenceLink[]

  @@index([memberId, assessmentDate])
  @@index([competencyId, assessmentDate])
}

model WorkforceEvidenceLink {
  id           Int                 @id @default(autoincrement())
  assessmentId Int
  label        String?
  url          String              @db.Text
  createdAt    DateTime            @default(now())
  assessment   WorkforceAssessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  @@index([assessmentId])
}

model Prompt {
  id        String   @id @default(cuid())
  name      String
  version   Int
  content   String   @db.Text
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([name, version])
  @@index([name, isActive, version])
}

model AiInteractionLog {
  id               String   @id @default(cuid())
  model            String
  promptName       String?
  promptVersion    Int?
  schemaVersion    String?
  rulesVersion     String?
  temperature      Float?
  userInput        String   @db.Text
  aiOutput         String?  @db.Text
  validationResult String?  @db.Text
  routingProvider  String?
  executionTimeMs  Int
  success          Boolean  @default(true)
  errorMessage     String?  @db.Text
  metadata         String?  @db.Text
  createdAt        DateTime @default(now())

  @@index([createdAt])
  @@index([promptName, promptVersion])
  @@index([schemaVersion])
  @@index([success, createdAt])
}
